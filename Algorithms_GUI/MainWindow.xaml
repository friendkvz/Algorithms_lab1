<Window x:Class="Algorithms_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:helix="http://helix-toolkit.org/wpf"
        xmlns:local="clr-namespace:Algorithms_GUI.Converters"
        Title="Анализ сложности алгоритмов"
        Width="1280"
        Height="800"
        MinWidth="950"
        MinHeight="600">
    <Window.Resources>

        <BooleanToVisibilityConverter
            x:Key="BoolToVisibility"/>

        <local:InverseBooleanToVisibilityConverter
            x:Key="InverseBoolToVisibility"/>

    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      Grid.Column="0"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Алгоритм"
                           FontWeight="Bold" />

                <ComboBox Margin="0,5,0,12"
                          ItemsSource="{Binding Algorithms}"
                          SelectedItem="{Binding SelectedAlgorithm}"
                          DisplayMemberPath="Name" />

                <TextBlock Text="N max" />
                <TextBox Margin="0,4,0,10"
                         Text="{Binding NMax, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Шаг по n" />
                <TextBox Margin="0,4,0,10"
                         Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Запусков на точку" />
                <TextBox Margin="0,4,0,10"
                         Text="{Binding Runs, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="M max для матриц" />
                <TextBox Margin="0,4,0,10"
                         Text="{Binding MMax, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Шаг по m" />
                <TextBox Margin="0,4,0,10"
                         Text="{Binding MStep, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Margin="0,4,0,12"
                          Content="Принудительный пересчёт"
                          IsChecked="{Binding ForceRecalculate}" />

                <Button Height="32"
                        Margin="0,2"
                        Content="Запустить эксперимент"
                        Command="{Binding RunCommand}" />

                <Button Height="30"
                        Margin="0,2"
                        Content="Отменить"
                        Command="{Binding CancelCommand}" />

                <Separator Margin="0,14" />

                <Button Height="30"
                        Margin="0,2"
                        Content="Загрузить исторические сессии"
                        Command="{Binding LoadSessionsCommand}" />

                <Button Height="30"
                        Margin="0,2"
                        Content="Сравнить сессии"
                        Command="{Binding CompareCommand}" />

                <TextBlock Margin="0,14,0,4"
                           Text="Исторические сессии"
                           FontWeight="Bold" />

                <ListBox Height="180"
                         ItemsSource="{Binding Sessions}"
                         DisplayMemberPath="DisplayName" />

                <TextBlock Margin="0,14,0,4"
                           Text="Аппроксимации"
                           FontWeight="Bold" />

                <ItemsControl ItemsSource="{Binding Approximations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2"
                                    Padding="4"
                                    BorderBrush="LightGray"
                                    BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayFormula, Mode=OneWay}" />
                                    <TextBlock FontSize="11"
                                               Foreground="Gray"
                                               Text="{Binding Mse, StringFormat=MSE: {0:G6}, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="0"
              Grid.Column="1">

            <!-- 2D график для обычных алгоритмов -->
            <oxy:PlotView
                Model="{Binding Plot, Mode=OneWay}"
                Visibility="{Binding IsMatrixAlgorithm,
                     Converter={StaticResource InverseBoolToVisibility}}" />

            <!-- 3D график для матриц -->
            <helix:HelixViewport3D
                x:Name="Matrix3DViewport"
                Visibility="{Binding IsMatrixAlgorithm, Converter={StaticResource BoolToVisibility}}"
                ZoomExtentsWhenLoaded="True"
                ShowViewCube="True"
                ShowCoordinateSystem="False"
                RotateAroundMouseDownPoint="True"
                ZoomAroundMouseDownPoint="True"
                CameraMode="Inspect"
                MouseMove="Matrix3DViewport_MouseMove"
                MouseDown="Matrix3DViewport_MouseDown"
                MouseUp="Matrix3DViewport_MouseUp"
                MouseLeave="Matrix3DViewport_MouseLeave">

                <!-- Источники света -->
                <helix:DefaultLights />

                <!-- Контейнер для кастомных осей, делений и сетки -->
                <ModelVisual3D x:Name="AxesContainer" />

                <!-- Поверхность 3D графика -->
                <helix:MeshGeometryVisual3D x:Name="MatrixSurface" />

            </helix:HelixViewport3D>

        </Grid>

        <Grid Grid.Row="1"
              Grid.ColumnSpan="2"
              Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ProgressBar Grid.Column="0"
                         Height="18"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Progress, Mode=OneWay}" />

            <StackPanel Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">

                <TextBlock Text="{Binding Status, Mode=OneWay}" />

                <StackPanel Orientation="Horizontal"
                            Margin="0,3,0,0">

                    <TextBlock Text="{Binding EstimatedTimeText, Mode=OneWay}" />

                    <TextBlock Margin="20,0,0,0"
                               Text="{Binding TotalTimeText, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>