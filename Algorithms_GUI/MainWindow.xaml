<Window x:Class="Algorithms_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Анализ сложности алгоритмов" Height="780" Width="1250" MinWidth="900" MinHeight="600">
    <Grid Margin="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Алгоритм" FontWeight="Bold"/><ComboBox ItemsSource="{Binding Algorithms}" SelectedItem="{Binding SelectedAlgorithm}" DisplayMemberPath="Name" Margin="0,4,0,12"/>
                <TextBlock Text="N max"/><TextBox Text="{Binding NMax, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                <TextBlock Text="Шаг"/><TextBox Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                <TextBlock Text="Запусков на точку"/><TextBox Text="{Binding Runs, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                <TextBlock Text="M max (матрицы)"/><TextBox Text="{Binding MMax, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                <TextBlock Text="Шаг M"/><TextBox Text="{Binding MStep, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                <CheckBox Content="Принудительный пересчёт" IsChecked="{Binding ForceRecalculate}" Margin="0,4,0,12"/>
                <Button Content="Запустить эксперимент" Command="{Binding RunCommand}" Height="32" Margin="0,2"/>
                <Button Content="Отменить" Command="{Binding CancelCommand}" Height="30" Margin="0,2"/>
                <Separator Margin="0,12"/>
                <Button Content="Загрузить исторические сессии" Command="{Binding LoadSessionsCommand}" Height="30" Margin="0,2"/>
                <Button Content="Сравнить загруженные сессии" Command="{Binding CompareCommand}" Height="30" Margin="0,2"/>
                <TextBlock Text="Сессии" FontWeight="Bold" Margin="0,12,0,4"/><ListBox ItemsSource="{Binding Sessions}" DisplayMemberPath="DisplayName" Height="180"/>
                <ItemsControl ItemsSource="{Binding Approximations}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayFormula}" ToolTip="{Binding Mse}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <oxy:PlotView Grid.Column="1" Model="{Binding Plot}"/>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
            <ProgressBar Width="300" Height="18" Minimum="0" Maximum="100" Value="{Binding Progress}"/>
            <TextBlock Text="{Binding Status}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
